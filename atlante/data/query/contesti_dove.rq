SELECT ?m ?prop ?x ?coord WHERE { VALUES ?tipo { wd:Q968159 wd:Q1792644 } ?m wdt:P31 ?tipo .
 { ?m wdt:P17 ?x BIND("P17" AS ?prop) } UNION { ?m wdt:P495 ?x BIND("P495" AS ?prop) } UNION { ?m wdt:P276 ?x BIND("P276" AS ?prop) } UNION { ?m wdt:P740 ?x BIND("P740" AS ?prop) }
 OPTIONAL { ?x wdt:P625 ?coord } }
